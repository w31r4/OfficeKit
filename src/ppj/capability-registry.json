  "authoredCompilerBoundaries": [
    {
      "feature": "gradient or no-fill chart series and image table-cell fills",
      "ppjPath": "chart data.series[].fill or table rows[].cells[].fill",
      "behavior": "fail-closed",
      "sourceBound": "Existing chart paint graphs and unsupported table-cell image fills remain source-preserved.",
      "reason": "Shape, slide-background, and table-cell gradients are compiler-owned. Chart-series paint currently owns direct opaque RGB only; chart and plot areas own none or solid RGB with opacity."
    },
    {
      "feature": "custom-path image masks",
      "ppjPath": "image.mask where kind is custom",
      "behavior": "fail-closed",
      "sourceBound": "Existing custom mask topology remains source-preserved.",
      "reason": "Authored and canonical imported preset masks own the complete ordered adjustment array; arbitrary custom mask paths remain native-owned."
    },
    {
      "feature": "independently rotated connector frames",
      "ppjPath": "connector.frame",
      "behavior": "fail-closed",
      "sourceBound": "Imported placement and transform topology remains source-preserved unless a matching typed capability is issued.",
      "reason": "Shape, text, placeholder, image, chart, table and group frames own rotation/flips; connector orientation remains endpoint-derived."
    },
    {
      "feature": "radar, waterfall and missing chart points",
      "ppjPath": "chart.chartType or chart.data.series[].values[]",
      "behavior": "fail-closed",
      "sourceBound": "Existing chart parts remain source-preserved; title and proven data-point edits use typed operations.",
      "reason": "The authored chart compiler owns finite bounded chart families, numeric scatter/bubble channels, and typed axes, labels, markers, trendlines and non-formula error bars where the native family permits them."
    },
    {
      "feature": "legend, data-label and axis-title typography",
      "ppjPath": "chart legend, data labels or axis titles",
      "behavior": "partial",
      "sourceBound": "Canonical chart-title and axis tick-label typography is projected and editable through the issued setChartTextStyle capability; richer or effect-bearing text graphs remain source-preserved.",
      "reason": "Authored charts own chart-title and axis tick-label Latin/East Asian typefaces, size, bold, italic and direct RGB/alpha. Legend, data-label and axis-title typography remain native-owned."
    },
    {
      "feature": "source-free media, SmartArt and OLE",
      "ppjPath": "pages[].elements[] where type is media, smartArt or ole",
      "behavior": "source-bound-only",
      "sourceBound": "Imported objects are classified and preserved; only issued nativeRef or typed capabilities may change them.",
      "reason": "PPJ models their persistent state, but authored native creation is not yet compiler-owned."
    },
    {
      "feature": "multi-header and image-filled authored tables",
      "ppjPath": "table.style",
      "behavior": "partial",
      "sourceBound": "Imported table topology and unmodeled styling remain source-preserved.",
      "reason": "Authored tables support bounded rich cell text, body and paragraph layout, none/solid/gradient cell fills, direct borders, banding and one header row. More than one header row and image cell fills fail closed."
    },
    {
      "feature": "theme-colored bullets and uncommon numbering schemes",
      "ppjPath": "text.paragraphs[].style.bullet",
      "behavior": "partial",
      "sourceBound": "Existing paragraph bullet leaves are editable only when capability-issued.",
      "reason": "Authored bullets currently accept explicit RGB plus the documented decimal, alpha and Roman schemes."
    },
    {
      "feature": "compound-shape global opacity",
      "ppjPath": "shape.style.opacity",
      "behavior": "partial",
      "sourceBound": "Imported unmodeled alpha graphs remain source-preserved unless an exact native leaf is issued.",
      "reason": "Fill, stroke, text, image, border, shadow and gradient-stop alpha are compiler-owned. Shape-wide opacity below one is accepted only for a solid-fill-only shape and is multiplied into that fill."
    }
  ],
