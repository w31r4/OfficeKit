{
  "schema": "office-kit/ppj/v1",
  "meta": {
    "id": "creative-direction-single-page",
    "title": "Precision in the dark",
    "language": "en-US",
    "version": 1,
    "description": "One-page creative-direction dogfood using a registered public-domain image search result."
  },
  "intent": {
    "brief": {
      "primaryJob": "inform",
      "supportingJobs": ["persuade"],
      "purpose": "Demonstrate how a visual thesis, searched image, and editable layers can carry a single idea.",
      "expectedOutcome": "The viewer understands that precision is designed through controlled surfaces, scale, and motion.",
      "evidenceBoundary": "The image is a public-domain NASA/Wikimedia asset; the headline and interpretation are editorial, not a claim about mission performance."
    },
    "audience": {
      "description": "Design and engineering leaders reviewing an image-led presentation direction.",
      "knowledgeLevel": "familiar",
      "needs": ["A clear visual thesis", "A credible image source", "Editable composition"]
    },
    "narrative": {
      "thesis": "Precision is a spatial system: controlled surfaces, scale, and one decisive signal.",
      "arc": [
        {
          "id": "arc-reveal",
          "purpose": "Make a designed system feel tangible before explaining it.",
          "claim": "The visual field is part of the message, not a backdrop added at the end."
        }
      ]
    },
    "editorial": {
      "tone": ["precise", "confident", "quietly cinematic"],
      "titleMode": "mixed",
      "lockedFacts": ["NASA spacecraft comparison image is public domain according to the registered Wikimedia machine-readable receipt."],
      "avoid": ["generic stock filler", "unbounded claims", "labels crossing the image subject"],
      "sourceStyle": "footnote"
    },
    "delivery": {
      "mode": "hybrid",
      "afterUse": "A visual calibration page for a later deck, with native text and image layers retained.",
      "mediumFit": "strong"
    }
  },
  "design": {
    "canvas": {
      "width": 960,
      "height": 540,
      "unit": "pt"
    },
    "theme": {
      "name": "Kinetic blue field",
      "colors": [
        {"id": "night", "value": "#071521", "role": "scrim and footer field"},
        {"id": "ink", "value": "#101820", "role": "dark type on signal field"},
        {"id": "ivory", "value": "#F7F2E8", "role": "reverse display type"},
        {"id": "signal", "value": "#FFD21E", "role": "single attention accent"},
        {"id": "blue", "value": "#164F9E", "role": "spatial wedge"},
        {"id": "quiet", "value": "#D4E1F2", "role": "secondary reverse text"}
      ]
    },
    "fonts": [
      {"id": "display", "family": "Arial", "fallbacks": ["Helvetica", "sans-serif"], "language": "en-US", "weight": 700},
      {"id": "body", "family": "Arial", "fallbacks": ["Helvetica", "sans-serif"], "language": "en-US", "weight": 400}
    ],
    "styles": {
      "text": [
        {
          "id": "kicker",
          "style": {
            "defaultText": {"font": "body", "size": 9, "bold": true, "letterSpacing": 1.8, "color": {"token": "ivory"}},
            "verticalAlignment": "top",
            "autoFit": "shrink-text",
            "margins": {"left": 0, "top": 0, "right": 0, "bottom": 0}
          }
        },
        {
          "id": "display-title",
          "style": {
            "defaultText": {"font": "display", "size": 46, "bold": true, "color": {"token": "ivory"}},
            "verticalAlignment": "top",
            "autoFit": "shrink-text",
            "margins": {"left": 0, "top": 0, "right": 0, "bottom": 0}
          }
        },
        {
          "id": "subtitle",
          "style": {
            "defaultText": {"font": "body", "size": 17, "color": {"token": "ivory"}},
            "verticalAlignment": "top",
            "autoFit": "shrink-text",
            "margins": {"left": 0, "top": 0, "right": 0, "bottom": 0}
          }
        },
        {
          "id": "meta",
          "style": {
            "defaultText": {"font": "body", "size": 9, "bold": true, "letterSpacing": 1.1, "color": {"token": "ivory"}},
            "verticalAlignment": "top",
            "autoFit": "shrink-text",
            "margins": {"left": 0, "top": 0, "right": 0, "bottom": 0}
          }
        },
        {
          "id": "caption",
          "style": {
            "defaultText": {"font": "body", "size": 9, "color": {"token": "quiet"}},
            "verticalAlignment": "top",
            "autoFit": "shrink-text",
            "margins": {"left": 0, "top": 0, "right": 0, "bottom": 0}
          }
        },
        {
          "id": "source",
          "style": {
            "defaultText": {"font": "body", "size": 7, "color": {"token": "quiet"}},
            "verticalAlignment": "top",
            "autoFit": "shrink-text",
            "margins": {"left": 0, "top": 0, "right": 0, "bottom": 0}
          }
        }
      ],
      "shape": [
        {
          "id": "scrim",
          "style": {"fill": {"type": "solid", "color": {"token": "night"}, "opacity": 0.76}}
        },
        {
          "id": "wedge",
          "style": {"fill": {"type": "solid", "color": {"token": "blue"}, "opacity": 0.9}}
        },
        {
          "id": "footer",
          "style": {"fill": {"type": "solid", "color": {"token": "night"}, "opacity": 0.9}}
        },
        {
          "id": "signal-rule",
          "style": {"fill": {"type": "solid", "color": {"token": "signal"}}}
        }
      ]
    },
    "grammar": {
      "name": "Kinetic field",
      "rationale": "A public-domain spacecraft image provides the field; one dark scrim, one blue wedge, and one yellow signal turn it into an editable visual direction.",
      "visualThesis": "Precision feels large when the image carries the field and type cuts a single controlled path through it.",
      "surfaceHierarchy": [
        "Use the photograph as a full-page field, darken only where type needs protection, and reserve the footer for source and navigation.",
        "Use the blue wedge as one spatial action, not as a container for unrelated content."
      ],
      "typographyRhythm": [
        "Use a two-line oversized statement, a single sentence of support, then quiet metadata.",
        "Keep the display face and body face from competing for attention."
      ],
      "geometryRules": [
        "The wedge and yellow rule establish direction; neither is a card or a decorative collection.",
        "Keep the image subject and every evidence-bearing label unobscured."
      ],
      "densityRhythm": [
        "Let the hero field carry most of the canvas; use the lower band for a compact source and role legend."
      ],
      "carrierRules": [
        "The searched NASA image carries identity and atmosphere; the title carries the editorial claim; the footer carries provenance."
      ],
      "imageRules": [
        "Use a registered public-domain asset with a focal crop; do not reuse it as filler or imply that the editorial headline is mission evidence."
      ],
      "motifs": [
        "One yellow rule and one yellow signal mark a deliberate point of attention.",
        "Small uppercase metadata anchors the page to a system without becoming a panel."
      ],
      "forbiddenPatterns": [
        "No card wall, random icon cloud, or generic rainbow accents.",
        "No text, footer, or detail image may cover the spacecraft silhouettes or the source line."
      ]
    },
    "motionPolicy": "adaptive"
  },
  "assets": [
    {
      "id": "spacecraft-comparison",
      "uri": ".office-kit/tasks/t_aad010978b0e/assets/images/5a3ddfbc6f2462a44af9a5d4b1dde58988511f3bf4b9e1c8aff8b980f234af62.jpg",
      "mimeType": "image/jpeg",
      "sha256": "5a3ddfbc6f2462a44af9a5d4b1dde58988511f3bf4b9e1c8aff8b980f234af62",
      "widthPx": 4669,
      "heightPx": 3559,
      "rights": {"status": "public-domain", "sourceUrl": "https://commons.wikimedia.org/wiki/File%3ANASA%20spacecraft%20comparison.jpg", "author": "NASA / Davis Paul Meltzer", "licenseName": "Public domain"},
      "accessibility": {"decorative": false, "description": "NASA illustration comparing spacecraft silhouettes against a textured blue field."}
    },
    {
      "id": "sparkles-mark",
      "uri": ".office-kit/tasks/t_aad010978b0e/assets/images/c9b8c90bdbb398d4ad3c341df794aea6486c77a62c3408cd74bbbdfee222023a.svg",
      "mimeType": "image/svg+xml",
      "sha256": "c9b8c90bdbb398d4ad3c341df794aea6486c77a62c3408cd74bbbdfee222023a",
      "widthPx": 24,
