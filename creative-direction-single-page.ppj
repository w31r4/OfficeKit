      "rights": {"status": "other", "sourceUrl": "https://lucide.dev/icons/sparkles", "author": "Lucide Contributors", "licenseName": "ISC License", "licenseUrl": "https://lucide.dev/license", "creditLine": "Lucide icon — ISC License (https://lucide.dev/license)"},
      "accessibility": {"decorative": true}
    },
    {
      "id": "thermal-vacuum-detail",
      "uri": ".office-kit/tasks/t_aad010978b0e/assets/images/f5e0c86529a6e9601ee46844e864bd2a63887b941e88fcad55ddc0e2397ef2bd.jpg",
      "mimeType": "image/jpeg",
      "sha256": "f5e0c86529a6e9601ee46844e864bd2a63887b941e88fcad55ddc0e2397ef2bd",
      "widthPx": 5568,
      "heightPx": 3712,
      "rights": {"status": "public-domain", "sourceUrl": "https://commons.wikimedia.org/wiki/File%3AA%20view%20of%20the%20OSAM-1%20spacecraft%20bus%20inside%20the%20thermal%20vacuum%20chamber%20at%20Goddard%20Space%20Flight%20Center%2C%20Greenbelt%20Md%20(GSFC%2020231201%20OSAM1%20047998).jpg", "author": "NASA Goddard Space Flight Center / Michael Guinto", "licenseName": "Public domain"},
      "accessibility": {"decorative": false, "description": "NASA engineers inspect a spacecraft bus inside a thermal vacuum chamber."}
    }
  ],
  "pages": [
    {
      "id": "page-01-precision",
      "name": "Precision in the dark",
      "role": "Make an image-led visual thesis tangible before explaining the system.",
      "claim": "Precision is designed through controlled surfaces, scale, and one decisive signal.",
      "background": {"type": "image", "asset": "spacecraft-comparison", "fit": "cover"},
      "notes": "Editorial calibration page. The NASA image is a public-domain identity/atmosphere carrier; the headline is an interpretation, not a mission-performance claim.",
      "transition": {"type": "fade", "durationMs": 420},
      "animations": [
        {"id": "title-reveal", "target": "page-title", "phase": "entrance", "effect": "fade", "start": "onClick", "durationMs": 620},
        {"id": "detail-reveal", "target": "detail-photo", "phase": "entrance", "effect": "wipe", "direction": "left", "start": "afterPrevious", "durationMs": 700}
      ],
      "elements": [
        {
          "id": "left-scrim",
          "type": "shape",
          "role": "Protect title contrast over the image field",
          "frame": {"x": 0, "y": 0, "width": 520, "height": 540},
          "accessibility": {"decorative": true},
          "geometry": {"kind": "preset", "preset": "rect"},
          "styleRef": "scrim"
        },
        {
          "id": "blue-wedge",
          "type": "shape",
          "role": "One directional spatial action",
          "frame": {"x": 0, "y": 318, "width": 585, "height": 222, "rotation": -3},
          "accessibility": {"decorative": true},
          "geometry": {
            "kind": "custom",
            "viewBox": {"x": 0, "y": 0, "width": 100, "height": 100},
            "paths": [{"fill": true, "stroke": false, "commands": [{"op": "moveTo", "x": 0, "y": 0}, {"op": "lineTo", "x": 100, "y": 0}, {"op": "lineTo", "x": 82, "y": 100}, {"op": "lineTo", "x": 0, "y": 100}, {"op": "close"}]}]
          },
          "styleRef": "wedge"
        },
        {
          "id": "page-kicker",
          "type": "text",
          "role": "navigation and provenance kicker",
          "frame": {"x": 58, "y": 40, "width": 420, "height": 18},
          "accessibility": {"decorative": false, "description": "Section kicker"},
          "text": "FIELD NOTE  /  SPACECRAFT SYSTEMS",
          "styleRef": "kicker"
        },
        {
          "id": "yellow-rule",
          "type": "shape",
          "role": "Signal mark",
          "frame": {"x": 58, "y": 86, "width": 74, "height": 4},
          "accessibility": {"decorative": true},
          "geometry": {"kind": "preset", "preset": "rect"},
          "styleRef": "signal-rule"
        },
        {
