{
  "schema": "office-kit/ppj/v1",
  "meta": {
    "id": "aqua-impact-story-reference-v2",
    "title": "Blue Belt 2027: Urban Water Access Pilot",
    "language": "en-US",
    "version": 2,
    "description": "OfficeKit clean-room calibration program for the Aqua Impact Story template. All program data is synthetic and illustrative."
  },
  "intent": {
    "brief": {
      "primaryJob": "report",
      "supportingJobs": [
        "explain",
        "mobilize"
      ],
      "purpose": "Show how an urban blue-green infrastructure pilot connects flood relief, habitat, and everyday public access.",
      "expectedOutcome": "A civic funding committee can identify the evidence chain and approve a bounded second phase.",
      "durationMinutes": 10,
      "evidenceBoundary": "All figures and place names are fictional calibration data. Photographs are public-domain contextual evidence and do not depict the fictional pilot.",
      "constraints": [
        "Preserve documentary image roles and visible source boundaries.",
        "Use yellow and blue only as chromatic accents.",
        "Never allow a curve, mask, label, or image to hide evidence."
      ]
    },
    "audience": {
      "description": "Civic funders, community partners, and public-space program leads.",
      "knowledgeLevel": "mixed",
      "decisionRole": "Approve, revise, or defer a second-phase urban water corridor program.",
      "needs": [
        "Human context",
        "Traceable outcomes",
        "A clear delivery chain",
        "A bounded funding decision"
      ]
    },
    "narrative": {
      "thesis": "A connected blue-green corridor earns expansion when access, water performance, and habitat move together.",
      "arc": [
        {
          "id": "arc-pressure",
          "purpose": "Locate the problem",
          "claim": "Four drainage gaps concentrate the pilot's risk and opportunity."
        },
        {
          "id": "arc-delivery",
          "purpose": "Show the intervention",
          "claim": "Restore, connect, and measure operate as one field chain."
        },
        {
          "id": "arc-evidence",
          "purpose": "Verify outcomes",
          "claim": "Access and ecological indicators improve without trading one objective for another."
        },
        {
          "id": "arc-decision",
          "purpose": "Make the next move",
          "claim": "Fund the network, preserve the gates, and keep local verification visible."
        }
      ]
    },
    "editorial": {
      "tone": [
        "human",
        "auditable",
        "public-interest"
      ],
      "titleMode": "conclusion",
      "lockedFacts": [
        "Every numeric result is synthetic and illustrative.",
        "Photographs are contextual public-domain references, not project documentation."
      ],
      "avoid": [
        "generic ESG slogans",
        "card walls",
        "decorative waves without meaning",
        "unqualified impact claims"
      ],
      "sourceStyle": "footnote"
    },
    "delivery": {
      "mode": "hybrid",
      "afterUse": "Funding record and partner briefing.",
      "mediumFit": "strong"
    }
  },
