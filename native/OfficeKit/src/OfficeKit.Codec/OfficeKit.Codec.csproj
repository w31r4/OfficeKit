<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OfficeKit.Codec</AssemblyName>
    <RootNamespace>OfficeKit.Codec</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.82.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../../proto/office_kit/artifact/v1/office_artifact.proto" GrpcServices="None" Link="Protos/office_artifact.proto" />
    <EmbeddedResource Include="../../../../src/ppj/ppj-v1.schema.json" LogicalName="OfficeKit.Ppj.V1.Schema.json" />
    <EmbeddedResource Include="../../../../src/ppj/preset-geometry-profiles.json" LogicalName="OfficeKit.Ppj.PresetGeometryProfiles.json" />
    <EmbeddedResource Include="../../../../src/ppj/font-awesome-free-icons.json" LogicalName="OfficeKit.Ppj.FontAwesomeFreeIcons.json" />
  </ItemGroup>
</Project>
