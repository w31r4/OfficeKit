{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officekit.dev/schema/smartart-definition-v1.schema.json",
  "title": "OfficeKit SmartArt definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "layout",
    "style",
    "colors"
  ],
  "properties": {
    "schema": {
      "const": "office-kit/smartart-definition/v1"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "enum": [
            "list",
            "process",
            "cycle",
            "hierarchy",
            "relationship",
            "matrix",
            "pyramid",
            "picture"
          ]
        },
        "operators": {
          "description": "Ordered bounded engine operators. V1 executes algorithm.placement, constraint.gapPoints, and rule.columns/reverse; other declared kinds fail closed at their exact path.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/operator"
          }
        }
      }
    },
    "style": {
      "$ref": "#/$defs/definitionSection"
    },
    "colors": {
      "$ref": "#/$defs/definitionSection"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "definitionSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "labels": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "description": "Only algorithm, constraint, and rule are executable in engine v1; the wider enum reserves typed future operators without granting execution.",
          "enum": [
            "select",
            "forEach",
            "choose",
            "algorithm",
            "constraint",
            "rule",
            "shape"
          ]
        },
        "input": {
          "type": "string",
          "enum": [
            "nodes"
          ]
        },
        "arguments": {
          "description": "algorithm accepts placement; constraint accepts gapPoints from 0 through 72; rule accepts columns from 1 through 64 and/or reverse.",
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
