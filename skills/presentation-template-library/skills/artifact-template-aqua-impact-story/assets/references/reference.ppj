    "grammar": {
      "name": "Documentary blue belt",
      "rationale": "Civic audiences need human context, geographic relationships, and outcomes that remain auditable after the emotional image lands.",
      "visualThesis": "Warm paper, documentary landscapes, one blue system, and one yellow decision signal turn public impact into a traceable story.",
      "surfaceHierarchy": [
        "Use a white gallery mat around warm paper, map blue, or one photographic field.",
        "Use yellow as a bounded decision surface, never as generic decoration."
      ],
      "typographyRhythm": [
        "Serif display language names the civic proposition; compact sans-serif carries evidence and sources.",
        "Let one oversized number or phrase dominate only when its denominator remains adjacent."
      ],
      "geometryRules": [
        "Curves trace water flow, geographic boundaries, or sequence only.",
        "Use short rules, baselines, and direct labels instead of containers."
      ],
      "densityRhythm": [
        "Alternate one image-led pause with dense map, chain, and ledger pages.",
        "Reserve open space outside labels and along the gallery mat."
      ],
      "carrierRules": [
        "Photography carries human and place context; maps carry distribution; tables carry audit detail; charts carry composition."
      ],
      "imageRules": [
        "Use distinct public-domain images for identity, access, and infrastructure roles.",
        "A full image receives a real native background or an explicit selectable image layer with a tested scrim."
      ],
      "chartRules": [
        "Use only the blue and yellow scales and label every circular segment directly.",
        "Keep chart backgrounds transparent."
      ],
      "diagramRules": [
        "A wave, path, or connector must identify a real site, phase, or handoff."
      ],
      "motifs": [
        "A single water curve identifies the network.",
        "A short yellow rule introduces a module or decision."
      ],
      "forbiddenPatterns": [
        "No card wall or equal panel grid.",
        "No random blobs or decorative rings.",
        "No line, marker, label, or source may be hidden by a mask or photo.",
        "No contextual photograph may be presented as project evidence."
      ]
    },
    "motionPolicy": "adaptive"
  },
