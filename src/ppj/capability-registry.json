  "classes": {
    "ppj-state": {
      "meaning": "Persistent authored state represented directly by office-kit/ppj/v1.",
      "agentRoute": "Edit the typed field in the .ppj file, then run ppj check/build."
    },
    "native-ref": {
      "meaning": "Imported-source capability represented by opaque/nativeRef and lowered fail-closed by C#.",
      "agentRoute": "Import, inspect the issued nativeRef capability, edit only declared fields, then rebuild from the bound source."
    },
    "compiler-helper": {
      "meaning": "Legacy facade or convenience constructor; not a public PPJ 2.0 authoring primitive.",
      "agentRoute": "Express the resulting state in PPJ. External programs may generate JSON, but Agents do not call this helper."
    },
    "inspect-review": {
      "meaning": "Discovery, validation, rendering, review, or package interoperability rather than persistent deck state.",
      "agentRoute": "Use the officekit ppj CLI command or review route; do not serialize the operation as slide content."
    },
    "host-only": {
      "meaning": "Operation against an open desktop PowerPoint session; never serialized into PPJ.",
      "agentRoute": "Use powerpoint-live-control only when the user explicitly targets the open application."
    }
  },
