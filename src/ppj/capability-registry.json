  "authoredCompilerBoundaries": [
    {
      "feature": "editable streamgraph",
      "ppjPath": "pages[].elements[] where chartType is area and style.stacking is stream",
      "behavior": "partial",
      "sourceBound": "OfficeKit-authored PPTX restores the exact streamgraph from its embedded PPJ program. Without that private program, the generated DrawingML imports truthfully as an editable group; arbitrary third-party paths are never inferred as stream semantics and receive no stream mutation capability.",
      "reason": "The compiler owns a bounded centered silhouette with 2..12 complete non-negative series over 3..64 ordered categories. It emits stable editable cubic paths and labels. Native ChartParts have no centered-stream stacking mode, so ChartPart build animation, negative or missing values, secondary axes, per-point labels and unsupported series options fail closed."
    },
    {
      "feature": "native chart labels, bubble scale and axis lines",
      "ppjPath": "pages[].elements[].style.dataLabels.numberFormat, pages[].elements[].style.bubbleScale/bubbleSizeMode and pages[].elements[].xAxis/yAxis/secondaryXAxis/secondaryYAxis reverse/axisLine/gridLine",
      "behavior": "partial",
      "sourceBound": "Recognized imported ChartParts issue setChartLabels for canonical chart-level data-label format, setChartPlot for native bubble scale and size semantics, and setChartAxis for bounded axis direction plus direct axis/grid line styling. Each capability owns only its declared field group and patches the existing ChartPart.",
      "reason": "PPJ owns one chart-level native number format, bubble scale from 0 through 300, native area/width size semantics, presence-aware axis reversal, and direct RGB/no-fill axis and major-grid lines. Per-point labels, pixel-radius ranges, logarithmic transforms, arrowed axes, theme/effect line graphs and unsupported topology remain source-owned and fail closed."
    },
    {
      "feature": "circular chart geometry",
      "ppjPath": "pages[].elements[].style.startAngle and pages[].elements[].style.holeSize",
      "behavior": "partial",
      "sourceBound": "Recognized imported pie and doughnut ChartParts issue setChartPlot for the bounded chart.plot field. PPJ may change first-slice angle and, for doughnuts, center-hole size without changing series topology or rebuilding the chart.",
      "reason": "The compiler owns native c:firstSliceAng from 0 through 360 and c:holeSize from 10 through 90. Other plot options and incompatible chart families fail closed."
    },
    {
      "feature": "native inline formulas",
      "ppjPath": "pages[].elements[].text.paragraphs[].runs[].formula",
      "behavior": "partial",
      "sourceBound": "An authored formula may be added inside ordinary compiler-owned rich text, including one eligible topmost typed text overlay on a source-bound page. Third-party a14:m/OMML is preserved but is never reverse-translated into guessed LaTeX, and existing imported formulas receive no mutation capability.",
      "reason": "PPJ compiles one bounded, non-executable LaTeX subset to canonical editable Office Math and restores the exact source only from an embedded PPJ snapshot. Arbitrary TeX, raw OMML, environments, macros and unsupported formula styling fail closed."
    },
    {
      "feature": "named icon catalog",
      "ppjPath": "pages[].elements[] where type is icon",
      "behavior": "partial",
      "sourceBound": "An authored icon may be added as a topmost typed overlay on an eligible source-bound page. Ordinary third-party custom geometry projects truthfully as shape or opaque content and is never inferred back into an icon name.",
      "reason": "PPJ resolves an exact bundled Font Awesome Free name to one finite editable DrawingML custom path. Unknown names, arbitrary SVG paths, external icon providers and semantic inference from native geometry fail closed."
    },
    {
      "feature": "independently rotated connector frames",
      "ppjPath": "connector.frame",
      "behavior": "fail-closed",
      "sourceBound": "Imported placement and transform topology remains source-preserved unless a matching typed capability is issued.",
      "reason": "Shape, text, placeholder, image, chart, table and group frames own rotation/flips; connector orientation remains endpoint-derived."
    },
    {
      "feature": "structured chart titles and other chart typography",
      "ppjPath": "chart.title, chart.style.titleTextStyle, chart.style.legendTextStyle, chart.style.dataLabels.textStyle and chart axes textStyle/titleTextStyle",
      "behavior": "partial",
      "sourceBound": "Bounded multi-paragraph/run chart titles are projected and editable through setChartTitle; canonical legend, data-label, axis-title and axis tick-label typography remains editable through setChartTextStyle. Unsupported title containers remain source-preserved.",
      "reason": "Authored ordinary and combo charts own structured title runs plus Latin/East Asian typefaces, size, bold, italic and direct RGB/alpha. Formula-backed titles, hyperlinks, theme transforms, WordArt, shadows, effects and unknown title topology remain outside the bounded profile."
    },
    {
      "feature": "third-party media playback graphs",
      "ppjPath": "pages[].elements[] where type is media and nativeRef is present",
      "behavior": "source-bound-only",
      "sourceBound": "Imported audio/video pictures, media relationships and timing graphs remain opaque-preserved unless a future capability proves the complete playback closure.",
      "reason": "Source-free PPJ owns a bounded canonical audio/video profile with an explicit poster, trim, loop and mute. It does not claim arbitrary third-party triggers, bookmarks, media effects or timing topology."
    },
    {
      "feature": "third-party partial element lock profiles",
      "ppjPath": "pages[].elements[].locked",
      "behavior": "partial",
      "sourceBound": "A recognized unlocked baseline or complete OfficeKit lock profile issues setLocked. Partial flags, extension-bearing locks and unknown combinations remain source-owned. Element visibility is proven separately and may still issue setHidden.",
      "reason": "One PPJ boolean cannot preserve the intent of every type-specific DrawingML lock combination without erasing native information."
    },
    {
      "feature": "source-free OLE",
      "ppjPath": "pages[].elements[] where type is ole",
      "behavior": "source-bound-only",
      "sourceBound": "Imported OLE objects are classified and preserved; only issued nativeRef or typed capabilities may change them.",
      "reason": "PPJ models OLE persistent state, but authored native OLE creation is not compiler-owned."
    },
    {
      "feature": "native Office SmartArt parts",
      "ppjPath": "pages[].elements[] where type is smartArt and mode is source-bound",
      "behavior": "source-bound-only",
      "sourceBound": "Imported SmartArt remains attached to its proven DiagramDataPart graph and accepts only issued node-text capabilities.",
      "reason": "Authored PPJ diagrams lower to editable groups of ordinary shapes, connectors, text and images; OfficeKit does not rebuild or fabricate a native SmartArt part graph."
    },
    {
      "feature": "native-theme bullet identity and uncommon numbering schemes",
      "ppjPath": "text.paragraphs[].style.bullet",
      "behavior": "partial",
      "sourceBound": "Existing paragraph bullet leaves are editable only when capability-issued.",
      "reason": "Authored bullets accept literal RGB/alpha or deck-local color tokens resolved to RGB/alpha, plus the documented decimal, alpha and Roman schemes. Existing native theme-token identity remains source-bound and leaf-editable rather than being guessed during source-free authoring."
    }
  ],
