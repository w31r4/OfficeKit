{
  "schema": "office-kit/ppj/v1",
  "meta": {
    "id": "evidence-ledger-reference",
    "title": "Evidence Ledger: Reliability Pilot",
    "language": "en-US",
    "version": 1,
    "description": "Original OfficeKit PPJ reference program for a dense, evidence-led experimental report. Every value is illustrative."
  },
  "intent": {
    "brief": {
      "primaryJob": "decide",
      "supportingJobs": [
        "explain",
        "handoff"
      ],
      "purpose": "Decide whether a bounded reliability intervention should advance from pilot to staged rollout.",
      "expectedOutcome": "The review board can approve, revise, or stop the rollout using five preset evidence gates.",
      "durationMinutes": 14,
      "evidenceBoundary": "All figures are synthetic calibration data created for this OfficeKit reference; they are not operational results.",
      "constraints": [
        "Keep the hypothesis falsifiable.",
        "Bind every conclusion to a visible measure or decision rule.",
        "Never allow labels, marks, bars, or lines to obscure one another."
      ]
    },
    "audience": {
      "description": "A technical review board with operations, finance, and statistical literacy.",
      "knowledgeLevel": "expert",
      "decisionRole": "Authorize a bounded rollout and its measurement protocol.",
      "needs": [
        "A falsifiable claim",
        "A controlled method",
        "A readable effect estimate",
        "Explicit stop conditions"
      ]
    },
    "narrative": {
      "thesis": "The pilot merits staged expansion only because incident hours fell while protected workload rose and all five preset gates passed.",
      "arc": [
        {
          "id": "arc-boundary",
          "purpose": "Define the test before revealing outcomes.",
          "claim": "A four-hour-ahead forecast is useful only if it reduces incident hours without shifting risk elsewhere."
        },
        {
          "id": "arc-method",
          "purpose": "Make assignment, measurement, and timing auditable.",
          "claim": "Matched sites and a preregistered window isolate the intervention from calendar and workload effects."
        },
        {
          "id": "arc-result",
          "purpose": "Show magnitude, uncertainty, and competing explanations.",
          "claim": "The measured effect clears the gate and survives workload growth."
        },
        {
          "id": "arc-decision",
          "purpose": "Translate evidence into a reversible action.",
          "claim": "Expand in two waves while preserving the same gates and stop rules."
        }
      ]
    },
    "editorial": {
      "tone": [
        "precise",
        "measured",
        "decision-oriented"
      ],
      "titleMode": "conclusion",
      "lockedFacts": [
        "Every value is synthetic and illustrative.",
        "The pilot contains 12 sites split evenly between control and treatment.",
        "The effect estimate is −26 incident hours with an illustrative 95% CI of −34 to −18."
      ],
      "avoid": [
        "unsupported causality",
        "card walls",
        "decorative geometry",
        "labels placed over evidence marks"
      ],
      "sourceStyle": "footnote"
    },
    "delivery": {
      "mode": "hybrid",
      "afterUse": "Decision record, rollout protocol, and reproducibility handoff.",
      "mediumFit": "strong"
    }
  },
  "design": {
    "canvas": {
      "width": 960,
      "height": 540,
      "unit": "pt"
    },
    "theme": {
      "name": "Evidence Ledger",
      "colors": [
        {
          "id": "paper",
          "value": "#F7F4EC",
          "role": "primary surface"
        },
        {
          "id": "paper-alt",
          "value": "#ECE9E1",
          "role": "secondary evidence field"
        },
        {
          "id": "ink",
          "value": "#17324D",
          "role": "primary text and structure"
        },
        {
          "id": "signal",
          "value": "#0B8F8F",
          "role": "measured signal"
        },
        {
          "id": "signal-soft",
          "value": "#CDE7E4",
          "role": "signal field"
        },
        {
          "id": "decision",
          "value": "#D9A514",
          "role": "decision emphasis"
        },
        {
          "id": "muted",
          "value": "#C9CDD1",
          "role": "baseline evidence"
        },
        {
          "id": "quiet",
          "value": "#64788B",
          "role": "secondary text"
        },
        {
          "id": "white",
          "value": "#FFFFFF",
          "role": "reverse text"
        }
      ]
    },
    "fonts": [
