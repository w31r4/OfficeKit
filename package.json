{
  "name": "office-kit",
  "version": "0.9.0",
  "description": "OfficeKit: agent-native Office and PDF Skills plus JavaScript APIs for creating, inspecting, editing, rendering, and verifying artifacts.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "officekit",
    "office",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "agent",
    "skills",
    "openxml",
    "mupdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w31r4/OfficeKit.git"
  },
  "bugs": {
    "url": "https://github.com/w31r4/OfficeKit/issues"
  },
  "homepage": "https://github.com/w31r4/OfficeKit#readme",
  "main": "./src/index.mjs",
  "bin": {
    "officekit": "./bin/officekit.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./live": "./src/live/bridge.mjs",
    "./live/protocol": "./src/live/protocol.mjs",
    "./live/adapters/powerpoint": "./src/live/adapters/powerpoint.mjs",
    "./powerpoint-live": "./src/powerpoint-live/repl.mjs",
    "./presentation-jsx": "./src/presentation-jsx/index.mjs",
    "./presentation-jsx/jsx-runtime": "./src/presentation-jsx/jsx-runtime.mjs",
    "./presentation-jsx/jsx-dev-runtime": "./src/presentation-jsx/jsx-dev-runtime.mjs",
    "./renderers/playwright": "./src/renderers/playwright.mjs",
    "./renderers/sharp": "./src/renderers/sharp.mjs",
    "./renderers/canvas": "./src/renderers/canvas.mjs",
    "./renderers/poppler": "./src/renderers/poppler.mjs",
    "./renderers/libreoffice": "./src/renderers/libreoffice.mjs",
    "./pdf/pdfjs": "./src/pdf/pdfjs.mjs",
    "./pdf/mupdf": "./src/pdf/mupdf.mjs",
    "./pdf/providers": "./src/pdf/providers/index.mjs",
    "./native/office-bridge": "./src/native/office-bridge.mjs",
    "./codec": "./src/codecs/office-kit.mjs",
    "./codec/wire": "./src/generated/office_kit/artifact/v1/office_artifact_pb.js"
  },
  "files": [
    ".claude-plugin/marketplace.json",
    "apps/excel-addin/dist/**",
    "apps/powerpoint-addin/dist/**",
    "bin/**",
    "src/**",
    "docs/template-library-provenance.md",
    "examples/**",
    "skills/documents/**",
    "skills/spreadsheets/**",
    "skills/presentations/**",
    "skills/pdf/**",
    "skills/office-kit/**",
    "skills/template-creator/**",
    "skills/default-template-library/**",
    "proto/**",
    "runtime/office-kit/**",
    "native/OfficeBridge/src/*.cs",
    "native/OfficeBridge/src/*.csproj",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "assets:png:check": "node scripts/optimize-skill-pngs.mjs --check",
    "assets:png:optimize": "node scripts/optimize-skill-pngs.mjs --write",
    "assets:json:compact": "node scripts/compact-skill-jsons.mjs --write",
    "proto:generate": "buf generate && node scripts/normalize-generated.mjs src/generated",
    "proto:check": "buf lint && npm run proto:generate && git diff --exit-code -- src/generated",
    "build:office-kit": "node scripts/build-office-kit.mjs",
    "build:excel-addin": "node scripts/build-excel-addin.mjs",
    "build:powerpoint-addin": "node scripts/build-powerpoint-addin.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "verify:office-kit-build": "node scripts/verify-office-kit-build.mjs",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test": "node scripts/run-test-gate.mjs fast",
    "test:fast": "node scripts/run-test-gate.mjs fast",
    "test:slow": "node scripts/run-test-gate.mjs slow",
    "test:slow:templates": "node test/default-template-library.mjs",
    "test:slow:promptbench": "node test/agent-evals.mjs",
    "eval:agents": "node scripts/run-agent-evals.mjs",
    "test:agent-evals": "node test/agent-evals.mjs",
    "test:agent-eval-branded-template": "node test/agent-eval-branded-template.mjs",
    "test:office-kit": "node test/office-kit.mjs",
    "test:font-metrics": "node test/font-metrics.mjs",
    "test:office-kit-dotnet": "dotnet test native/OfficeKit/OfficeKit.sln --configuration Release",
    "test:spreadsheet": "node test/spreadsheet.mjs && node test/spreadsheet-statistics.mjs && node test/spreadsheet-formula-syntax.mjs && node test/spreadsheet-range-compat.mjs && node test/spreadsheet-sparkline.mjs",
    "test:skill:spreadsheets": "node test/spreadsheet-skill.mjs",
    "test:presentation": "node test/presentation.mjs && node test/presentation-svg-leaves.mjs",
    "test:pptx-lossless-benchmark": "node test/pptx-lossless-benchmark.mjs",
    "test:pptx-svg-leaf-benchmark": "node test/pptx-svg-leaf-benchmark.mjs",
    "test:pptx-import-object-classification": "node test/pptx-import-object-classification.mjs",
    "test:pptx-import-object-classification-evidence": "node test/pptx-import-object-classification-evidence.mjs",
    "test:pptx-design-profile": "node test/pptx-design-profile.mjs",
    "test:pptx-source-continuation": "node test/pptx-source-continuation.mjs",
    "test:pptx-source-continuation-native": "node test/pptx-source-continuation-native.mjs",
    "test:pptx-source-derived-companion": "node test/pptx-source-derived-companion.mjs",
    "test:pptx-source-agent-continuation": "node test/pptx-source-agent-continuation.mjs",
    "test:presentation-jsx": "node test/presentation-jsx.mjs",
    "test:skill:presentations": "node test/presentation-skill.mjs && node test/presentation-template-edit.mjs",
    "test:template-library": "node test/template-library.mjs",
    "test:default-template-library": "node test/default-template-library.mjs",
    "test:template-creator": "node test/template-creator.mjs",
    "test:skill:office-kit": "node test/office-kit-skill.mjs",
    "test:officekit-cli": "node test/officekit-cli.mjs",
    "test:repl": "node test/presentation-authoring-plan.mjs && node test/officekit-tasks.mjs && node test/officekit-repl.mjs && node test/officekit-repl-interrupted-write.mjs && node test/officekit-task-artifacts.mjs",
    "test:excel-live": "node scripts/build-excel-addin.mjs && node test/excel-live.mjs",
    "test:powerpoint-live": "node scripts/build-powerpoint-addin.mjs && node test/powerpoint-live.mjs",
    "test:standalone": "node test/standalone-distribution.mjs",
    "test:document": "node test/document.mjs",
    "test:skill:documents": "node test/document-skill.mjs && node test/document-table-formatting-workflow.mjs && node test/document-table-header-rows-workflow.mjs && node test/document-table-row-break-policy-workflow.mjs && node test/document-table-accessibility-workflow.mjs && node test/document-image-alt-text-workflow.mjs",
    "test:pdf": "node test/pdf.mjs",
    "test:pdf-providers": "node test/pdf-providers.mjs",
    "test:pdf-provider-packs": "node test/pdf-provider-pack-build.mjs && node test/pdf-provider-release-tools.mjs && node test/pdf-python-pack-build.mjs && node test/pdf-ocr-pack-build.mjs && node test/pdf-poppler-pack-build.mjs && node test/pdf-verapdf-pack-build.mjs",
    "test:skill:pdf": "node test/pdf-skill.mjs",
    "test:skill:pdf-providers": "node test/pdf-provider-skill.mjs && node test/pdf-qpdf-provider.mjs && node test/pdf-pikepdf-provider.mjs && node test/pdf-pyhanko-provider.mjs && node test/pdf-pyhanko-certified-form-fill.mjs && node test/pdf-pyhanko-sign-provider.mjs && node test/pdf-verapdf-provider.mjs && node test/pdf-ocrmypdf-provider.mjs",
    "test:skill:sync": "node test/reference-skill-sync.mjs",
    "test:skill:reference": "node test/reference-skills.mjs",
    "test:claude-plugin": "node test/claude-plugin.mjs",
    "test:verify": "node test/verify.mjs",
    "test:review": "node test/review.mjs",
    "test:render": "node test/render.mjs",
    "test:visual-baselines": "node test/visual-baselines.mjs",
    "test:renderer-adapters": "node test/renderer-adapters.mjs",
    "test:playwright-renderer": "node test/playwright-renderer.mjs",
    "test:office-bridge": "node test/office-bridge.mjs",
    "test:office-bridge-dotnet": "dotnet test native/OfficeBridge",
    "test:examples": "node test/examples.mjs",
    "test:release-check": "node test/release-check.mjs",
    "test:package-contents": "node test/package-contents.mjs",
    "test:help": "node test/help.mjs && node test/help-adoption.mjs",
    "test:presentation-authoring-eval": "node test/presentation-authoring-eval-manifest.mjs",
    "test:presentation-authoring-packed": "node test/presentation-authoring-packed.mjs",
    "test:presentation-authoring-pilot": "node test/presentation-authoring-pilot.mjs",
    "eval:presentation-authoring-pilot": "node scripts/presentation-authoring-pilot.mjs",
    "eval:presentation-authoring-expansion": "node scripts/presentation-authoring-expansion.mjs",
    "eval:score-presentation-authoring-pilot": "node scripts/score-presentation-authoring-pilot.mjs",
    "test:pack": "node test/office-kit-package.mjs && npm pack --dry-run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@firecrawl/anydoc": "0.1.3",
    "jszip": "^3.10.1",
    "mupdf": "1.28.0",
    "selfsigned": "^5.5.0"
  },
  "peerDependencies": {
    "canvas": ">=2.11.0",
    "pdfjs-dist": ">=4.0.0",
    "playwright": ">=1.40.0",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "pako": "1.0.11",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.61.1",
    "sharp": "^0.34.5",
    "typescript": "^5.4.5"
  }
}
