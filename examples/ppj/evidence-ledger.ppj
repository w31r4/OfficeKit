    "grammar": {
      "name": "Measured field note",
      "rationale": "A technical board needs dense evidence with explicit reading order, visible uncertainty, and no dashboard ornament.",
      "visualThesis": "Warm paper, one measured signal, and one decision color separate observation from judgment.",
      "surfaceHierarchy": [
        "Use paper as the default field and pale signal only for bounded evidence regions.",
        "Use rules, alignment, and scale instead of nested containers."
      ],
      "typographyRhythm": [
        "Serif display language frames the research question; sans-serif text carries protocol and evidence.",
        "Conclusion titles lead; page furniture remains quiet."
      ],
      "geometryRules": [
        "Every line, node, band, and mark must encode a threshold, sequence, comparison, or measured magnitude.",
        "Never add empty rings, floating circles, or unlabelled decorative geometry."
      ],
      "densityRhythm": [
        "Alternate spacious framing pages with dense method and evidence pages.",
        "Reserve the bottom ledger strip for the actionable read-through."
      ],
      "carrierRules": [
        "Charts carry quantitative claims; tables carry audit detail; connectors carry dependency."
      ],
      "imageRules": [
        "Use imagery only as evidence or identity; this technical reference intentionally relies on native data graphics."
      ],
      "chartRules": [
        "Keep labels outside marks, keep trends on truthful axes, and separate bar and line evidence when overlap would obscure either."
      ],
      "diagramRules": [
        "Connectors express a real branch, dependency, or handoff and terminate at an explicit object."
      ],
      "motifs": [
        "A short ochre rule marks a preset decision gate.",
        "A thin navy rule anchors each page to the evidence ledger."
      ],
      "forbiddenPatterns": [
        "No card wall or equal panel grid.",
        "No meaningless ring or decorative node.",
        "No line, marker, bar, label, or connector may obscure another required value.",
        "No synthetic calibration value may be presented as real-world evidence."
      ]
    },
    "motionPolicy": "adaptive"
  },
  "components": [
